{% extends 'base.html.twig' %}
{% block title %}Accueil - Le Guide de l'Expert Dresseur{% endblock %}
{% block body %}
<div class="container-fluid px-0">
    <!-- Section 1 : Hero Header -->
    <header class="hero-header d-flex flex-column justify-content-center align-items-center text-center mx-3 mt-3">
        <div class="hero-overlay"></div>
        <div class="hero-content w-100">
            <h1 class="display-4 fw-bold mb-4">Le Guide de l'Expert Dresseur</h1>
            <p class="lead mb-4">Retrouvez toutes les informations sur les Pokémon, Dresseurs et Arènes.</p>
            
            <form action="{{ path('app_search') }}" method="GET" class="w-100 d-flex justify-content-center">
                <input type="text" name="q" class="form-control search-bar-giant" placeholder="Que cherchez-vous aujourd'hui, Dresseur ?" aria-label="Recherche" required>
            </form>
            
            <div class="quick-tags">
                <a href="{{ path('app_pokedex_index') }}" class="quick-tag">#Pikachu</a>
                <a href="{{ path('app_arene_index') }}" class="quick-tag">#BadgeRoche</a>
                <a href="{{ path('app_dresseur_index') }}" class="quick-tag">#TopDresseurs</a>
                <a href="{{ path('app_pokedex_index') }}" class="quick-tag">#TypeSpectre</a>
            </div>
        </div>
    </header>

    <div class="container mt-5">
        <!-- Section 2 : Navigation Rapide -->
        <h2 class="section-title text-center d-block">L'Encyclopédie</h2>
        <div class="row g-4 mt-2 justify-content-center">
            <!-- Pokédex -->
            <div class="col-md-6 col-lg-3">
                <a href="{{ path('app_pokedex_index') }}" class="text-decoration-none text-dark">
                    <div class="card pokenav-card text-center p-4">
                        <div class="icon-container color-pokedex">
                            <i class="bi bi-record-circle-fill"></i>
                        </div>
                        <h4 class="fw-bold">Le Pokédex</h4>
                        <p class="text-muted small">Tous les Pokémon par ID, Type ou Région.</p>
                    </div>
                </a>
            </div>
            <!-- Dresseurs -->
            <div class="col-md-6 col-lg-3">
                <a href="{{ path('app_dresseur_index') }}" class="text-decoration-none text-dark">
                    <div class="card pokenav-card text-center p-4">
                        <div class="icon-container color-center">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <h4 class="fw-bold">Annuaire Dresseurs</h4>
                        <p class="text-muted small">Champions d'Arène, Conseil 4 et Rivaux.</p>
                    </div>
                </a>
            </div>
            <!-- Arènes -->
            <div class="col-md-6 col-lg-3">
                <a href="{{ path('app_arene_index') }}" class="text-decoration-none text-dark">
                    <div class="card pokenav-card text-center p-4">
                        <div class="icon-container color-badge">
                            <i class="bi bi-shield-fill-check"></i>
                        </div>
                        <h4 class="fw-bold">Le Guide des Arènes</h4>
                        <p class="text-muted small">Localisation, Badges et Teams à battre.</p>
                    </div>
                </a>
            </div>
            <!-- Types -->
            <div class="col-md-6 col-lg-3">
                <a href="#" class="text-decoration-none text-dark">
                    <div class="card pokenav-card text-center p-4">
                        <div class="icon-container color-type">
                            <i class="bi bi-grid-3x3-gap-fill"></i>
                        </div>
                        <h4 class="fw-bold">Table des Types</h4>
                        <p class="text-muted small">Outil stratégique pour voir les faiblesses.</p>
                    </div>
                </a>
            </div>
        </div>

        <!-- Section 3 : Aujourd'hui dans le monde Pokémon -->
        <h2 class="section-title text-center d-block mt-5 pt-4">Aujourd'hui dans le monde Pokémon</h2>
        <div class="row g-4 mt-2 mb-5">
            <!-- Pokémon Sauvage du Jour -->
            <div class="col-md-4">
                <div class="daily-card h-100">
                    <h5 class="fw-bold color-pokedex mb-3"><i class="bi bi-star-fill text-warning"></i> Pokémon Sauvage du Jour</h5>
                    {% if pokemonDuJour %}
                        <img src="{{ pokemonDuJour.imagePrincipale }}" alt="{{ pokemonDuJour.nom }}" class="img-fluid rounded mb-3" style="max-height: 150px; object-fit: contain;">
                        <h4 class="fw-bold">{{ pokemonDuJour.nom }} N°{{ pokemonDuJour.numeroPokedex }}</h4>
                        <p class="small text-muted mb-3">{{ pokemonDuJour.description|slice(0, 100) ~ '...' }}</p>
                        <a href="{{ path('app_pokedex_show', {'nom': pokemonDuJour.nom}) }}" class="btn btn-pokedex w-100">Voir la fiche</a>
                    {% else %}
                        <p class="text-muted">Aucun Pokémon sauvage n'a été aperçu aujourd'hui.</p>
                    {% endif %}
                </div>
            </div>

            <!-- Challenge d'Arène -->
            <div class="col-md-4">
                <div class="daily-card h-100">
                    <h5 class="fw-bold color-badge mb-3"><i class="bi bi-shield-shaded"></i> Le Challenge d'Arène</h5>
                    {% if areneDuJour %}
                        {% if areneDuJour.badge %}
                        <img src="{{ asset('images/Badges/' ~ areneDuJour.badge) }}" alt="Badge {{ areneDuJour.nom }}" class="img-fluid rounded mb-3" style="max-height: 100px; object-fit: contain;">
                        {% endif %}
                        <h4 class="fw-bold">{{ areneDuJour.nom }}</h4>
                        <p class="small text-muted mb-3">L'Arène de {{ areneDuJour.lieu }} ouvre ses portes. Êtes-vous prêt ?</p>
                        <a href="{{ path('app_arene_show', {'slug': areneDuJour.slug}) }}" class="btn btn-outline-dark w-100">Affronter l'Arène</a>
                    {% else %}
                        <p class="text-muted">Aucune Arène n'est ouverte aujourd'hui.</p>
                    {% endif %}
                </div>
            </div>

            <!-- News / Derniers Ajouts -->
            <div class="col-md-4">
                <div class="daily-card text-start h-100 overflow-hidden">
                    <h5 class="fw-bold color-center mb-3 text-center"><i class="bi bi-newspaper"></i> Dernières Découvertes</h5>
                    
                    <h6 class="fw-bold border-bottom pb-2">Nouveaux Pokémon</h6>
                    <ul class="list-unstyled">
                        {% for p in pokemons %}
                            <li class="mb-2"><a href="{{ path('app_pokedex_show', {'nom': p.nom}) }}" class="text-decoration-none text-dark"><i class="bi bi-caret-right-fill color-pokedex"></i> {{ p.nom }} (N°{{ p.numeroPokedex }})</a></li>
                        {% else %}
                            <li class="text-muted small">Aucun nouveau Pokémon.</li>
                        {% endfor %}
                    </ul>

                    <h6 class="fw-bold border-bottom pb-2 mt-3">Nouveaux Dresseurs</h6>
                    <ul class="list-unstyled">
                        {% for d in dresseurs %}
                            <li class="mb-2"><a href="{{ path('app_dresseur_show', {'slug': d.slug}) }}" class="text-decoration-none text-dark"><i class="bi bi-caret-right-fill color-center"></i> {{ d.nom }} {{ d.prenom }}</a></li>
                        {% else %}
                            <li class="text-muted small">Aucun nouveau Dresseur.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Audio for interaction -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050">
    <button id="muteBtn" class="btn btn-dark rounded-circle shadow" title="Activer/Désactiver le son" style="width: 50px; height: 50px;">
        <i class="bi bi-volume-up-fill" id="muteIcon" style="font-size: 1.2rem;"></i>
    </button>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const muteBtn = document.getElementById('muteBtn');
            const muteIcon = document.getElementById('muteIcon');
            // Le son est activé par défaut, mais les navigateurs requièrent une interaction
            let isMuted = false;
            let audioCtx = null;

            const playSound = () => {
                if (isMuted) return;
                try {
                    if (!audioCtx) {
                        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    }
                    if (audioCtx.state === 'suspended') {
                        audioCtx.resume();
                    }
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(880, audioCtx.currentTime); // A5 note
                    osc.frequency.exponentialRampToValueAtTime(440, audioCtx.currentTime + 0.1); 
                    gain.gain.setValueAtTime(0.05, audioCtx.currentTime); // Volume très bas
                    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.1);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.1);
                } catch(e) {
                    console.log('Audio disabled or not supported');
                }
            };

            // Ajouter le son sur les éléments interactifs
            document.querySelectorAll('.pokenav-card, .btn, .quick-tag, .dropdown-item').forEach(item => {
                item.addEventListener('mouseenter', playSound);
            });

            // Toggle mute
            muteBtn.addEventListener('click', function(e) {
                e.preventDefault();
                isMuted = !isMuted;
                if (isMuted) {
                    muteIcon.classList.replace('bi-volume-up-fill', 'bi-volume-mute-fill');
                    muteBtn.classList.replace('btn-dark', 'btn-secondary');
                } else {
                    muteIcon.classList.replace('bi-volume-mute-fill', 'bi-volume-up-fill');
                    muteBtn.classList.replace('btn-secondary', 'btn-dark');
                    playSound(); // Jouer un son pour confirmer l'activation
                }
            });
        });
    </script>
{% endblock %}