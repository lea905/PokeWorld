{% extends 'base.html.twig' %}

{% block title %}Les Arènes - PokeWorld{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="text-primary fw-bold display-5">Ligue Pokémon</h1>
        <p class="lead text-secondary">Défiez les champions et collectez tous les badges !</p>
    </div>

    <div class="row g-4">
        {% for arene in arenes %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-lg overflow-hidden position-relative arene-card">
                     <!-- Background décoratif -->
                     <div class="position-absolute top-0 start-0 w-100 h-100 bg-light opacity-25"></div>
                    
                    <div class="card-body position-relative text-center p-4">
                        {% if arene.imageBadge %}
                            <div class="mb-3 d-inline-block p-3 rounded-circle bg-white shadow-sm">
                                <img src="{{ asset(arene.imageBadge) }}" alt="Badge {{ arene.badge }}" class="img-fluid" style="width: 80px; height: 80px; object-fit: contain;">
                            </div>
                        {% else %}
                             <div class="mb-3 d-inline-block p-3 rounded-circle bg-white shadow-sm">
                                <i class="fas fa-certificate fa-3x text-warning"></i>
                            </div>
                        {% endif %}

                        <h3 class="card-title fw-bold text-dark mb-1">{{ arene.nom }}</h3>
                        <p class="text-uppercase text-muted small fw-bold tracking-wide">{{ arene.region }}</p>
                        
                        <div class="d-flex justify-content-center align-items-center gap-2 mb-4">
                            <span class="badge bg-danger rounded-pill"><i class="fas fa-map-marker-alt me-1"></i> {{ arene.lieu }}</span>
                            <span class="badge bg-gold text-dark border border-warning rounded-pill"><i class="fas fa-award me-1"></i> Badge {{ arene.badge }}</span>
                        </div>
                        
                        {% if arene.champion %}
                            <div class="d-flex align-items-center justify-content-center bg-white rounded p-2 shadow-sm mb-3">
                                {% if arene.champion.image %}
                                    <img src="{{ asset(arene.champion.image) }}" class="rounded-circle me-2" alt="{{ arene.champion.nom }}" style="width: 40px; height: 40px; object-fit: cover;">
                                {% else %}
                                    <div class="rounded-circle bg-secondary me-2 d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px;">
                                        <i class="fas fa-user-ninja"></i>
                                    </div>
                                {% endif %}
                                <div class="text-start">
                                    <small class="d-block text-muted" style="line-height:1;">Champion</small>
                                    <span class="fw-bold text-dark">{{ arene.champion.nom }}</span>
                                </div>
                            </div>
                        {% endif %}

                        <a href="{{ path('app_arene_show', {'id': arene.id}) }}" class="btn btn-primary w-100 rounded-pill fw-bold">Défier l'Arène</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <i class="fas fa-dungeon fa-4x text-muted mb-3"></i>
                <p class="h4 text-muted">Aucune arène n'a été construite pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</div>

<style>
    .bg-gold {
        background-color: #ffd700;
    }
    .tracking-wide {
        letter-spacing: 0.1em;
    }
    .arene-card:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
    }
</style>
{% endblock %}
