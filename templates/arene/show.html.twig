{% extends 'base.html.twig' %}

{% block title %}{{ arene.nom }} - PokeWorld{% endblock %}

{% block body %}
<div class="container my-5">
    <!-- En-tête de l'Arène -->
    <div class="card border-0 shadow-lg overflow-hidden mb-5 rounded-4">
        <div class="row g-0">
            <div class="col-md-4 bg-primary text-white d-flex align-items-center justify-content-center p-5 text-center position-relative">
                <div class="position-absolute start-0 top-0 w-100 h-100 bg-gradient text-white" style="opacity: 0.1;"></div>
                <div class="position-relative z-1">
                    {% if arene.imageBadge %}
                        <img src="{{ asset(arene.imageBadge) }}" alt="Badge {{ arene.badge }}" class="img-fluid drop-shadow mb-3" style="max-height: 180px;">
                    {% else %}
                        <i class="fas fa-certificate fa-8x text-white-50"></i>
                    {% endif %}
                    <h2 class="fw-bold mt-2">Badge {{ arene.badge }}</h2>
                </div>
            </div>
            <div class="col-md-8 p-5">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h1 class="display-4 fw-bold text-primary mb-0">{{ arene.nom }}</h1>
                        <p class="h4 text-muted fw-light">{{ arene.region }}</p>
                    </div>
                     <span class="badge bg-warning text-dark fs-5 align-self-center"><i class="fas fa-map-marker-alt me-2"></i>{{ arene.lieu }}</span>
                </div>
                
                <hr class="my-4">
                
                <div class="row">
                     <div class="col-12">
                         <h4 class="fw-bold mb-3"><i class="fas fa-crown text-warning me-2"></i>Le Champion</h4>
                         {% if arene.champion %}
                            <div class="d-flex align-items-center bg-light p-3 rounded-3 shadow-sm">
                                {% if arene.champion.image %}
                                    <img src="{{ asset(arene.champion.image) }}" class="rounded-circle border border-3 border-white shadow-sm me-3" alt="{{ arene.champion.nom }}" style="width: 80px; height: 80px; object-fit: cover;">
                                {% else %}
                                    <div class="rounded-circle bg-secondary me-3 d-flex align-items-center justify-content-center text-white border border-3 border-white shadow-sm" style="width: 80px; height: 80px;">
                                        <i class="fas fa-user-ninja fa-2x"></i>
                                    </div>
                                {% endif %}
                                
                                <div class="flex-grow-1">
                                    <h3 class="mb-1 text-dark fw-bold">{{ arene.champion.nom }} {{ arene.champion.prenom }}</h3>
                                    <p class="text-muted mb-0 small">{{ arene.champion.description|slice(0, 100) }}...</p>
                                </div>
                                <a href="{{ path('app_dresseur_show', {id: arene.champion.id}) }}" class="btn btn-outline-primary rounded-pill">Voir le profil</a>
                            </div>
                         {% else %}
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i> Cette arène n'a pas encore de champion officialisé.
                            </div>
                         {% endif %}
                     </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="text-center">
        <a href="{{ path('app_arene_index') }}" class="btn btn-secondary rounded-pill px-4"><i class="fas fa-arrow-left me-2"></i>Retour aux arènes</a>
    </div>

</div>

<style>
    .drop-shadow {
        filter: drop-shadow(0 10px 8px rgba(0,0,0,0.3));
    }
</style>
{% endblock %}
