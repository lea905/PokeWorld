{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}PokeWorld Admin{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-12 mt-4">
            <div class="alert alert-info shadow-sm border-0">
                <i class="fas fa-info-circle me-2"></i> Bienvenue dans l'interface d'administration de <strong>PokeWorld</strong> !
            </div>
            
            <div class="row mt-4">
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title fw-bold"><i class="fas fa-user mb-2 text-primary"></i> Dresseurs</h5>
                            <p class="card-text text-muted">Gérez les dresseurs, leurs infos et ajoutez des Pokémon à leur équipe.</p>
                            <a href="{{ path('admin', {crudAction: 'index', crudControllerFqcn: 'App\\Controller\\Admin\\DresseurCrudController'}) }}" class="btn btn-outline-primary btn-sm">Gérer les Dresseurs</a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title fw-bold"><i class="fas fa-users mb-2 text-success"></i> Équipes</h5>
                            <p class="card-text text-muted">Vue d'ensemble de toutes les équipes Pokémon.</p>
                            <a href="{{ path('admin', {crudAction: 'index', crudControllerFqcn: 'App\\Controller\\Admin\\EquipeCrudController'}) }}" class="btn btn-outline-success btn-sm">Gérer les Équipes</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                     <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title fw-bold"><i class="fas fa-dragon mb-2 text-danger"></i> Pokémon</h5>
                            <p class="card-text text-muted">Liste de tous les Pokémon importés.</p>
                            <a href="{{ path('admin', {crudAction: 'index', crudControllerFqcn: 'App\\Controller\\Admin\\PokemonCrudController'}) }}" class="btn btn-outline-danger btn-sm">Voir les Pokémon</a>
                        </div>
                    </div>
                </div>
                 <div class="col-md-6 mb-4">
                     <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title fw-bold"><i class="fas fa-building mb-2 text-warning"></i> Arènes</h5>
                            <p class="card-text text-muted">Gestion des arènes et badges.</p>
                            <a href="{{ path('admin', {crudAction: 'index', crudControllerFqcn: 'App\\Controller\\Admin\\AreneCrudController'}) }}" class="btn btn-outline-warning btn-sm">Gérer les Arènes</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
