{% extends 'base.html.twig' %}

{% block title %}{{ pokemon.nom }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <a href="{{ path('app_pokedex_index') }}" class="btn btn-outline-secondary mb-4">&larr; Retour au Pokedex</a>

        <div class="row">
            <div class="col-md-5 mb-4">
                <div class="card shadow border-0">
                    <div class="card-body text-center bg-light rounded">
                        <img src="{{ pokemon.imagePrincipale }}" class="img-fluid w-75 animate__animated animate__fadeIn" alt="{{ pokemon.nom }}">
                    </div>
                </div>
            </div>
            
            <div class="col-md-7">
                <div class="d-flex align-items-center mb-3">
                    <h1 class="display-4 fw-bold me-3">{{ pokemon.nom }}</h1>
                    <span class="text-muted fs-4">#{{ pokemon.numeroPokedex }}</span>
                </div>
                 <h4 class="text-muted mb-4">{{ pokemon.nomJaponais }}</h4>

                <div class="mb-4">
                     <span class="badge rounded-pill fs-6 px-3 py-2 text-bg-{{ pokemon.type1.nom|lower }} me-2">{{ pokemon.type1.nom }}</span>
                    {% if pokemon.type2 %}
                        <span class="badge rounded-pill fs-6 px-3 py-2 text-bg-{{ pokemon.type2.nom|lower }}">{{ pokemon.type2.nom }}</span>
                    {% endif %}
                </div>

                <div class="mb-5">
                    <h3 class="h5 border-bottom pb-2 mb-3">Description</h3>
                    <p class="lead fs-6">{{ pokemon.description }}</p>
                </div>

                <div class="row">
                    <div class="col-12 mb-4">
                        <h3 class="h5 border-bottom pb-2 mb-3">Statistiques de base</h3>
                         <div class="row g-3">
                            <div class="col-6 col-md-4">
                                <div class="p-3 border rounded text-center bg-light">
                                    <div class="text-muted small">PV</div>
                                    <div class="fw-bold fs-5">{{ pokemon.pv }}</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <div class="p-3 border rounded text-center bg-light">
                                    <div class="text-muted small">Attaque</div>
                                    <div class="fw-bold fs-5">{{ pokemon.attaque }}</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <div class="p-3 border rounded text-center bg-light">
                                    <div class="text-muted small">Défense</div>
                                    <div class="fw-bold fs-5">{{ pokemon.defense }}</div>
                                </div>
                            </div>
                             <div class="col-6 col-md-4">
                                <div class="p-3 border rounded text-center bg-light">
                                    <div class="text-muted small">Attaque Spé.</div>
                                    <div class="fw-bold fs-5">{{ pokemon.attaqueSpe }}</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <div class="p-3 border rounded text-center bg-light">
                                    <div class="text-muted small">Défense Spé.</div>
                                    <div class="fw-bold fs-5">{{ pokemon.defenceSpe }}</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <div class="p-3 border rounded text-center bg-light">
                                    <div class="text-muted small">Vitesse</div>
                                    <div class="fw-bold fs-5">{{ pokemon.vitesse }}</div>
                                </div>
                            </div>
                         </div>
                    </div>
                </div>
        </div>

                {# Evolution Chain Section #}
        {% if pokemon.evolutionRoot.evolutionsSuivantes|length > 0 or pokemon.evolutionRoot.evolutionPrecedente %}
        <div class="row mt-5">
            <div class="col-12">
                <h3 class="h4 border-bottom pb-2 mb-4">Famille d'évolution</h3>
                <div class="row justify-content-center text-center align-items-center">
                    {% import _self as macros %}
                    
                    {# Define the recursive macro #}
                    {% macro render_evolution(p, current_pokemon) %}
                        {% import _self as macros %}
                        
                        {# Display current node #}
                        <div class="col-6 col-md-3 mb-3">
                            <div class="card {{ p.idPokemon == current_pokemon.idPokemon ? 'border-primary border-2 shadow' : 'border-0 shadow-sm' }} h-100">
                                <div class="card-body">
                                    <h6 class="{{ p.idPokemon == current_pokemon.idPokemon ? 'text-primary' : 'text-muted' }} text-uppercase small mb-2">
                                        {{ p.idPokemon == current_pokemon.idPokemon ? 'Actuel' : (p.evolutionPrecedente ? 'Évolution' : 'Base') }}
                                    </h6>
                                    <a href="{{ path('app_pokedex_show', {'nom': p.nom}) }}" class="text-decoration-none text-dark">
                                        <img src="{{ p.imagePrincipale }}" 
                                             alt="{{ p.nom }}" 
                                             class="img-fluid mb-2" 
                                             style="max-height: {{ p.idPokemon == current_pokemon.idPokemon ? '120px' : '100px' }};">
                                        <div class="fw-bold">{{ p.nom }}</div>
                                    </a>
                                </div>
                            </div>
                        </div>

                        {# If there are next evolutions, display arrow and recurse #}
                        {% if p.evolutionsSuivantes|length > 0 %}
                            <div class="col-1 d-none d-md-flex justify-content-center">
                                <i class="bi bi-arrow-right fs-3 text-muted"></i>
                            </div>
                            
                            {# If multiple evolutions (branching), wrap them #}
                            {% if p.evolutionsSuivantes|length > 1 %}
                                <div class="col-md-auto">
                                    <div class="row flex-nowrap overflow-auto">
                                        {% for next_evo in p.evolutionsSuivantes %}
                                            {{ macros.render_evolution(next_evo, current_pokemon) }}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% else %}
                                {% for next_evo in p.evolutionsSuivantes %}
                                    {{ macros.render_evolution(next_evo, current_pokemon) }}
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                    {% endmacro %}

                    {# Start rendering from root #}
                    {{ macros.render_evolution(pokemon.evolutionRoot, pokemon) }}
                </div>
            </div>
        </div>
        {% endif %}

    </div>
{% endblock %}
