{% extends 'base.html.twig' %}

{% block title %}{{ pokemon.nom }} - Pokédex{% endblock %}

{% block body %}
    <!-- Hero Section with Type Background -->
    <div class="hero-pokemon bg-type-{{ pokemon.type1.nom|lower|replace({'é': 'e', 'è': 'e'}) }}">
        <div class="container position-relative z-1">
            <div class="row align-items-center">
                <div class="col-lg-5 text-center text-lg-start mb-5 mb-lg-0">
                    <a href="{{ path('app_pokedex_index') }}" class="btn btn-light rounded-pill px-4 mb-4 shadow-sm text-decoration-none fw-bold" style="opacity: 0.9;">
                        &larr; Retour au Pokédex
                    </a>
                    <div class="d-flex align-items-center justify-content-center justify-content-lg-start mb-2">
                        <span class="fs-4 text-dark opacity-50 fw-bold me-3">#{{ pokemon.numeroPokedex }}</span>
                    </div>
                    <h1 class="display-3 fw-bold text-dark text-uppercase mb-1" style="letter-spacing: -1px;">{{ pokemon.nom }}</h1>
                    <h4 class="text-dark opacity-50 mb-4 ms-1">{{ pokemon.nomJaponais }}</h4>
                    
                    <div class="d-flex justify-content-center justify-content-lg-start gap-2">
                        <span class="badge rounded-pill fs-6 px-4 py-2 glass-badge text-bg-{{ pokemon.type1.nom|lower|replace({'é': 'e', 'è': 'e'}) }}">{{ pokemon.type1.nom }}</span>
                        {% if pokemon.type2 %}
                            <span class="badge rounded-pill fs-6 px-4 py-2 glass-badge text-bg-{{ pokemon.type2.nom|lower|replace({'é': 'e', 'è': 'e'}) }}">{{ pokemon.type2.nom }}</span>
                        {% endif %}
                    </div>
                </div>
                <div class="col-lg-7 text-center">
                    <img src="{{ pokemon.imagePrincipale }}" class="hero-pokemon-img img-fluid animate__animated animate__fadeIn" alt="{{ pokemon.nom }}">
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-5 mb-5">
        <div class="row g-4">
            
            <!-- Description -->
            <div class="col-12">
                <div class="glass-panel p-4 p-md-5 bg-white shadow-sm border-0">
                    <h3 class="h4 fw-bold mb-4 opacity-75">Description</h3>
                    <p class="lead fs-5 text-secondary" style="line-height: 1.8;">{{ pokemon.description }}</p>
                </div>
            </div>

            <!-- Stats -->
            <div class="col-12">
                <div class="glass-panel p-4 p-md-5 bg-white shadow-sm border-0">
                    <h3 class="h4 fw-bold mb-4 opacity-75">Statistiques de base</h3>
                    <div class="row g-4">
                        {% set stats = [
                            {'label': 'PV', 'value': pokemon.pv},
                            {'label': 'Attaque', 'value': pokemon.attaque},
                            {'label': 'Défense', 'value': pokemon.defense},
                            {'label': 'Atq Spé', 'value': pokemon.attaqueSpe},
                            {'label': 'Déf Spé', 'value': pokemon.defenceSpe},
                            {'label': 'Vitesse', 'value': pokemon.vitesse}
                        ] %}
                        
                        {% for stat in stats %}
                            {# Calculate percentage relative to max possible stat roughly #}
                            {% set percentage = (stat.value / 255 * 100)|round %}
                            {% set barClass = 'stat-bar-low' %}
                            {% if stat.value >= 65 %}{% set barClass = 'stat-bar-mid' %}{% endif %}
                            {% if stat.value >= 90 %}{% set barClass = 'stat-bar-high' %}{% endif %}
                            {% if stat.value >= 130 %}{% set barClass = 'stat-bar-ultra' %}{% endif %}
                            
                            <div class="col-md-6">
                                <div class="stat-row">
                                    <div class="stat-label">{{ stat.label }}</div>
                                    <div class="stat-value">{{ stat.value }}</div>
                                    <div class="stat-bar-container">
                                        <div class="stat-bar {{ barClass }}" style="width: {{ percentage }}%"></div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Evolutions -->
            {% if pokemon.evolutionRoot.evolutionsSuivantes|length > 0 or pokemon.evolutionRoot.evolutionPrecedente %}
            <div class="col-12 mt-4">
                <div class="glass-panel p-4 p-md-5 bg-white shadow-sm border-0">
                    <h3 class="h4 fw-bold mb-4 opacity-75">Famille d'évolution</h3>
                    <div class="row justify-content-center text-center align-items-center">
                        {% import _self as macros %}
                        
                        {% macro render_evolution(p, current_pokemon) %}
                            {% import _self as macros %}
                            
                            <div class="col-12 col-sm-6 col-md-3 mb-3">
                                <div class="evolution-card card border-{{ p.idPokemon == current_pokemon.idPokemon ? 'primary' : 'light' }} {{ p.idPokemon == current_pokemon.idPokemon ? 'border-2 shadow' : 'border-1 shadow-sm' }} h-100">
                                    <div class="card-body">
                                        <h6 class="{{ p.idPokemon == current_pokemon.idPokemon ? 'text-primary fw-bold' : 'text-muted' }} text-uppercase small mb-3">
                                            {{ p.idPokemon == current_pokemon.idPokemon ? 'Actuel' : (p.evolutionPrecedente ? 'Évolution' : 'Base') }}
                                        </h6>
                                        <a href="{{ path('app_pokedex_show', {'nom': p.nom}) }}" class="text-decoration-none text-dark d-block">
                                            <img src="{{ p.imagePrincipale }}" 
                                                 alt="{{ p.nom }}" 
                                                 class="img-fluid mb-3" 
                                                 style="max-height: {{ p.idPokemon == current_pokemon.idPokemon ? '130px' : '110px' }}; object-fit: contain;">
                                            <div class="fw-bold fs-5">{{ p.nom }}</div>
                                            {% if p.type1 is defined and p.type1 %}
                                                <div class="mt-2 text-center d-flex justify-content-center">
                                                    <span style="width:12px; height:12px; display:inline-block; border-radius:50%;" class="text-bg-{{ p.type1.nom|lower|replace({'é': 'e', 'è': 'e'}) }}"></span>
                                                    {% if p.type2 is defined and p.type2 %}
                                                        <span style="width:12px; height:12px; display:inline-block; border-radius:50%; margin-left:4px;" class="text-bg-{{ p.type2.nom|lower|replace({'é': 'e', 'è': 'e'}) }}"></span>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        </a>
                                    </div>
                                </div>
                            </div>

                            {% if p.evolutionsSuivantes|length > 0 %}
                                <div class="col-1 d-none d-md-flex justify-content-center">
                                    <i class="bi bi-arrow-right fs-4 text-muted opacity-50"></i>
                                </div>
                                
                                {% if p.evolutionsSuivantes|length > 1 %}
                                    <div class="col-md-auto">
                                        <div class="row flex-nowrap overflow-auto pb-2">
                                            {% for next_evo in p.evolutionsSuivantes %}
                                                {{ macros.render_evolution(next_evo, current_pokemon) }}
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% else %}
                                    {% for next_evo in p.evolutionsSuivantes %}
                                        {{ macros.render_evolution(next_evo, current_pokemon) }}
                                    {% endfor %}
                                {% endif %}
                            {% endif %}
                        {% endmacro %}

                        {{ macros.render_evolution(pokemon.evolutionRoot, pokemon) }}
                    </div>
                </div>
            </div>
            {% endif %}

        </div>
    </div>

    <!-- Stat Bars display managed by inline style -->
{% endblock %}
